---
// Cycles system → light → dark. Icons: monitor, sun, moon.
const icon = "size-5 fill-none stroke-current stroke-2 [stroke-linecap:round] [stroke-linejoin:round]";
---

<button
  id="theme-toggle"
  type="button"
  class="-my-1 flex size-9 items-center justify-center rounded-full text-gray-400 transition-colors hover:bg-gray-200/60 hover:text-gray-700 dark:text-gray-500 dark:hover:bg-white/10 dark:hover:text-gray-200"
>
  <svg data-icon="system" viewBox="0 0 24 24" class={icon} aria-hidden="true">
    <rect x="3" y="4" width="18" height="12" rx="2"></rect>
    <path d="M8 20h8M12 16v4"></path>
  </svg>
  <svg data-icon="light" viewBox="0 0 24 24" class:list={[icon, "hidden"]} aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg data-icon="dark" viewBox="0 0 24 24" class:list={[icon, "hidden"]} aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<script>
  type Pref = "system" | "light" | "dark";
  const ORDER: Pref[] = ["system", "light", "dark"];
  const LABELS: Record<Pref, string> = {
    system: "Theme: follow system",
    light: "Theme: light",
    dark: "Theme: dark",
  };

  const button = document.getElementById("theme-toggle")!;

  function current(): Pref {
    try {
      const saved = localStorage.getItem("theme");
      if (saved === "light" || saved === "dark") return saved;
    } catch {}
    return "system";
  }

  function show(pref: Pref) {
    for (const svg of button.querySelectorAll<SVGElement>("[data-icon]")) {
      svg.classList.toggle("hidden", svg.dataset.icon !== pref);
    }
    button.setAttribute("aria-label", `${LABELS[pref]}. Click to change.`);
    button.title = LABELS[pref];
  }

  button.addEventListener("click", () => {
    const next = ORDER[(ORDER.indexOf(current()) + 1) % ORDER.length];
    try {
      if (next === "system") localStorage.removeItem("theme");
      else localStorage.setItem("theme", next);
    } catch {}
    (window as unknown as { applyTheme: () => void }).applyTheme();
    show(next);
  });

  show(current());
</script>

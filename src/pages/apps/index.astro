---
import { apps } from "../../data/apps";
import Base from "../../layouts/Base.astro";
---

<Base title="Apps · pebabion" description="Small apps built by pebabion">
  <h1 class="mt-8 mb-2 text-3xl font-semibold">Apps</h1>
  <p class="mb-8 text-gray-600 dark:text-gray-400">Small tools I built for myself.</p>
  <ul class="mb-12 grid gap-4 sm:grid-cols-2">
    {
      apps.map((app) => (
        <li>
          <a
            href={`/apps/${app.slug}/`}
            class="flex h-full gap-4 rounded-xl border border-gray-200 bg-white p-4 hover:border-green-600 dark:border-gray-700 dark:bg-secondary-dark-bg"
          >
            <span class="text-3xl" aria-hidden="true">{app.emoji}</span>
            <span>
              <span class="block font-semibold">{app.name}</span>
              <span class="block text-base text-gray-600 dark:text-gray-400">{app.description}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

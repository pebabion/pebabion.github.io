---
import Base from "../../../layouts/Base.astro";

const units = [
  { id: "mi", label: "min/mi" },
  { id: "km", label: "min/km" },
  { id: "mph", label: "mph" },
  { id: "kmh", label: "km/h" },
];
// Everything below the input sits in one 3-column grid so it fits on a phone
// screen without scrolling. The tile for the input unit is hidden, leaving 9.
const results = [
  { id: "mi", label: "min/mi" },
  { id: "km", label: "min/km" },
  { id: "mph", label: "mph" },
  { id: "kmh", label: "km/h" },
  { id: "ms", label: "m/s" },
  { id: "lap", label: "400 m lap" },
  { id: "5k", label: "5K", race: true },
  { id: "10k", label: "10K", race: true },
  { id: "half", label: "Half", race: true },
  { id: "full", label: "Marathon", race: true },
];
const field =
  "w-full min-w-0 rounded-lg border-0 bg-white/15 px-3 py-1 text-4xl font-bold tabular-nums text-white placeholder:text-white/40 focus:bg-white/25 focus:outline-none";
---

<Base title="Running converter · pebabion" description="Convert a running pace or speed into every other unit, with race finish times.">
  <div class="mx-auto max-w-xl pb-12">
    <h1 class="mb-3 text-2xl font-semibold sm:mt-8">Running converter</h1>

    <section class="rounded-2xl bg-green-700 p-3 text-white dark:bg-green-800" aria-label="Input">
      <div class="grid grid-cols-4 gap-1 rounded-xl bg-black/20 p-1" role="radiogroup" aria-label="Input unit">
        {
          units.map((u) => (
            <button
              type="button"
              role="radio"
              data-unit={u.id}
              class="min-h-10 rounded-lg text-base font-semibold text-white/80 aria-checked:bg-white aria-checked:text-green-800"
            >
              {u.label}
            </button>
          ))
        }
      </div>

      <div id="pace-input" class="mt-3 flex items-center gap-2">
        <input id="min" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="2" placeholder="8" aria-label="Minutes" class={field} />
        <span class="text-4xl font-bold">:</span>
        <input id="sec" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="2" placeholder="30" aria-label="Seconds" class={field} />
      </div>
      <div id="speed-input" class="mt-3" hidden>
        <input id="speed" type="text" inputmode="decimal" placeholder="7.0" aria-label="Speed" class={field} />
      </div>

      <!-- One-tap adjustments; hold a button to keep stepping. -->
      <div class="mt-3 grid grid-cols-4 gap-2" aria-label="Adjust">
        {
          [-2, -1, 1, 2].map((n) => (
            <button
              type="button"
              data-step={n}
              class="min-h-12 touch-manipulation rounded-xl bg-white/15 text-xl font-bold tabular-nums select-none active:bg-white/35"
            />
          ))
        }
      </div>
      <!-- Relative drag: the value moves with your finger, not to where you touch. -->
      <div
        id="scrub"
        role="slider"
        tabindex="0"
        aria-label="Swipe to change"
        class="scrub mt-3 flex h-12 cursor-ew-resize items-center justify-between rounded-xl px-2 text-lg font-bold text-white/60 select-none"
      >
        <span class="rounded-md bg-green-900 px-2" aria-hidden="true">‹</span>
        <span class="rounded-md bg-green-900 px-2 py-0.5 text-sm font-semibold tracking-wide uppercase" aria-hidden="true">swipe</span>
        <span class="rounded-md bg-green-900 px-2" aria-hidden="true">›</span>
      </div>
    </section>

    <section class="mt-3 grid grid-cols-3 gap-2" aria-label="Results" aria-live="polite">
      {
        results.map((r) => (
          <div
            data-result={r.id}
            class:list={[
              "rounded-lg border bg-white px-2 py-1.5 dark:bg-secondary-dark-bg",
              r.race ? "border-green-600/60" : "border-gray-200 dark:border-gray-700",
            ]}
          >
            <span class="block text-xs text-gray-500 dark:text-gray-400">{r.label}</span>
            <strong data-out={r.id} class="text-lg tabular-nums">–</strong>
          </div>
        ))
      }
    </section>

    <button
      id="save"
      type="button"
      disabled
      class="mt-3 min-h-12 w-full rounded-xl bg-green-600 text-lg font-semibold text-white hover:bg-green-700 disabled:opacity-40"
    >
      Save to history
    </button>

    <section class="mt-6" aria-labelledby="history-title">
      <div class="mb-2 flex items-center justify-between">
        <h2 id="history-title" class="text-lg font-semibold">History</h2>
        <button id="clear" type="button" hidden class="min-h-11 px-2 text-base text-red-600 hover:underline dark:text-red-400">
          Clear all
        </button>
      </div>
      <p id="history-empty" class="text-base text-gray-500 dark:text-gray-400">
        Saved conversions show up here. They stay on this device only.
      </p>
      <ul id="history" class="divide-y divide-gray-200 dark:divide-gray-700"></ul>
    </section>
  </div>
</Base>

<script>
  type Unit = "mi" | "km" | "mph" | "kmh";
  type Entry = { id: string; at: number; unit: Unit; secPerKm: number };

  const KM_PER_MI = 1.609344;
  const RACES_KM = { "5k": 5, "10k": 10, half: 21.0975, full: 42.195 };
  // Step sizes in the unit's own terms (seconds or speed).
  const STEPS: Record<Unit, { small: number; big: number }> = {
    mi: { small: 5, big: 15 },
    km: { small: 5, big: 15 },
    mph: { small: 0.1, big: 0.5 },
    kmh: { small: 0.1, big: 0.5 },
  };
  // Swipe distance for one small step. Higher is less sensitive.
  const PX_PER_STEP = 25;
  const DEFAULT_SEC_PER_KM = 540 / KM_PER_MI; // 9:00 /mi
  const LAST_KEY = "running-converter:last:v1";
  const STORAGE_KEY = "running-converter:history:v1";
  const MAX_HISTORY = 200;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const minEl = $<HTMLInputElement>("min");
  const secEl = $<HTMLInputElement>("sec");
  const speedEl = $<HTMLInputElement>("speed");
  const saveBtn = $<HTMLButtonElement>("save");
  const clearBtn = $<HTMLButtonElement>("clear");
  const historyEl = $<HTMLUListElement>("history");
  const scrub = $<HTMLDivElement>("scrub");
  const unitButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-unit]")];
  const stepButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-step]")];

  let unit: Unit = "mi";
  let secPerKm: number | null = null;

  // Formatting

  function clock(totalSec: number) {
    const s = Math.round(totalSec);
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    const ss = String(s % 60).padStart(2, "0");
    return h ? `${h}:${String(m).padStart(2, "0")}:${ss}` : `${m}:${ss}`;
  }
  const kmh = (spk: number) => 3600 / spk;

  function outputs(spk: number): Record<string, string> {
    const out: Record<string, string> = {
      mi: clock(spk * KM_PER_MI),
      km: clock(spk),
      mph: (kmh(spk) / KM_PER_MI).toFixed(2),
      kmh: kmh(spk).toFixed(2),
      ms: (1000 / spk).toFixed(2),
      lap: clock(spk * 0.4),
    };
    for (const [id, km] of Object.entries(RACES_KM)) out[id] = clock(spk * km);
    return out;
  }

  function describeInput(e: Pick<Entry, "unit" | "secPerKm">) {
    const o = outputs(e.secPerKm);
    const trim = (v: string) => String(Number(v));
    return { mi: `${o.mi} /mi`, km: `${o.km} /km`, mph: `${trim(o.mph)} mph`, kmh: `${trim(o.kmh)} km/h` }[e.unit];
  }

  // Input → seconds per km

  function readInput(): number | null {
    if (isPace(unit)) {
      const m = Number(minEl.value || 0);
      const s = Number(secEl.value || 0);
      if (!Number.isFinite(m) || !Number.isFinite(s) || s >= 60) return null;
      const sec = m * 60 + s;
      return sec > 0 ? fromUnit(sec) : null;
    }
    const v = Number(speedEl.value.replace(",", "."));
    return Number.isFinite(v) && v > 0 ? fromUnit(v) : null;
  }

  const isPace = (u: Unit) => u === "mi" || u === "km";

  // Seconds per mile/km for pace units, mph/km/h for speed units.
  function toUnit(spk: number, u: Unit = unit) {
    return { mi: spk * KM_PER_MI, km: spk, mph: kmh(spk) / KM_PER_MI, kmh: kmh(spk) }[u];
  }
  function fromUnit(v: number, u: Unit = unit) {
    return { mi: v / KM_PER_MI, km: v, mph: 3600 / (v * KM_PER_MI), kmh: 3600 / v }[u];
  }

  function writeInput(spk: number) {
    const v = toUnit(spk);
    if (isPace(unit)) {
      const total = Math.round(v);
      minEl.value = String(Math.floor(total / 60));
      secEl.value = String(total % 60).padStart(2, "0");
    } else {
      speedEl.value = String(Number(v.toFixed(2)));
    }
  }

  // Set a new value from the steppers or swipe: update the input too.
  function setValue(v: number) {
    const { small } = STEPS[unit];
    v = Math.max(small, Math.round(v / small) * small);
    secPerKm = fromUnit(v);
    writeInput(secPerKm);
    render();
  }

  function step(n: number) {
    const { small, big } = STEPS[unit];
    const current = toUnit(secPerKm ?? DEFAULT_SEC_PER_KM);
    setValue(current + Math.sign(n) * (Math.abs(n) === 2 ? big : small));
  }

  function render() {
    const o = secPerKm ? outputs(secPerKm) : null;
    document.querySelectorAll<HTMLElement>("[data-out]").forEach((el) => {
      el.textContent = o ? o[el.dataset.out!] : "–";
    });
    // Hide the result that just repeats the input.
    document.querySelectorAll<HTMLElement>("[data-result]").forEach((el) => {
      el.hidden = el.dataset.result === unit;
    });
    saveBtn.disabled = !secPerKm;
    if (secPerKm) {
      scrub.setAttribute("aria-valuetext", isPace(unit) ? `${clock(toUnit(secPerKm))} per ${unit}` : `${toUnit(secPerKm).toFixed(1)} ${unit}`);
      try {
        localStorage.setItem(LAST_KEY, JSON.stringify({ unit, secPerKm }));
      } catch {
        // Not critical.
      }
    }
  }

  function setUnit(next: Unit) {
    unit = next;
    for (const b of unitButtons) b.setAttribute("aria-checked", String(b.dataset.unit === unit));
    $("pace-input").hidden = !isPace(unit);
    $("speed-input").hidden = isPace(unit);

    const c = STEPS[unit];
    const sign = (n: number) => (n < 0 ? "−" : "+");
    for (const b of stepButtons) {
      const n = Number(b.dataset.step);
      const size = Math.abs(n) === 2 ? c.big : c.small;
      b.textContent = `${sign(n)}${isPace(unit) ? `${size}s` : size}`;
    }
    if (secPerKm) writeInput(secPerKm);
    render();
  }

  // History, kept in this browser only

  function loadHistory(): Entry[] {
    try {
      const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "[]");
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }

  function storeHistory(entries: Entry[]) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(entries.slice(0, MAX_HISTORY)));
    } catch {
      // Storage blocked or full; history just won't persist.
    }
  }

  let history = loadHistory();

  function renderHistory() {
    historyEl.replaceChildren(
      ...history.map((e) => {
        const o = outputs(e.secPerKm);
        const li = document.createElement("li");
        li.className = "flex items-center gap-2";

        const load = document.createElement("button");
        load.type = "button";
        load.className = "min-h-14 flex-1 py-2 text-left";
        load.innerHTML = `
          <span class="block font-semibold tabular-nums"></span>
          <span class="block text-sm text-gray-600 tabular-nums dark:text-gray-400"></span>
          <span class="block text-xs text-gray-500"></span>`;
        const [title, detail, when] = load.children as unknown as HTMLElement[];
        title.textContent = describeInput(e);
        detail.textContent = [
          e.unit !== "mi" && `${o.mi} /mi`,
          e.unit !== "km" && `${o.km} /km`,
          e.unit !== "mph" && `${o.mph} mph`,
          e.unit !== "kmh" && `${o.kmh} km/h`,
          `Marathon ${o.full}`,
        ]
          .filter(Boolean)
          .join(" · ");
        when.textContent = new Date(e.at).toLocaleString(undefined, { dateStyle: "medium", timeStyle: "short" });
        load.setAttribute("aria-label", `Load ${describeInput(e)}`);
        load.addEventListener("click", () => {
          secPerKm = e.secPerKm;
          setUnit(e.unit);
          window.scrollTo({ top: 0, behavior: "smooth" });
        });

        const del = document.createElement("button");
        del.type = "button";
        del.className =
          "flex size-11 shrink-0 items-center justify-center rounded-full text-2xl text-gray-400 hover:bg-gray-100 hover:text-red-600 dark:hover:bg-gray-700";
        del.textContent = "×";
        del.setAttribute("aria-label", `Delete ${describeInput(e)}`);
        del.addEventListener("click", () => {
          history = history.filter((h) => h.id !== e.id);
          storeHistory(history);
          renderHistory();
        });

        li.append(load, del);
        return li;
      }),
    );
    $("history-empty").hidden = history.length > 0;
    clearBtn.hidden = history.length === 0;
  }

  // Wiring

  for (const b of unitButtons) b.addEventListener("click", () => setUnit(b.dataset.unit as Unit));
  for (const el of [minEl, secEl, speedEl]) {
    el.addEventListener("input", () => {
      secPerKm = readInput();
      render();
    });
  }
  // Select the whole value on tap so typing replaces it. iOS ignores select()
  // during focus, so defer it, and keep a mouse click from clearing it.
  for (const el of [minEl, secEl, speedEl]) {
    let justFocused = false;
    el.addEventListener("focus", () => {
      justFocused = true;
      setTimeout(() => el.setSelectionRange(0, el.value.length), 0);
    });
    el.addEventListener("mouseup", (ev) => {
      if (justFocused) ev.preventDefault();
      justFocused = false;
    });
  }
  // Jump to seconds once the minutes look complete.
  minEl.addEventListener("input", () => {
    if (minEl.value.length === 2) secEl.focus();
  });
  for (const el of [minEl, secEl, speedEl]) {
    el.addEventListener("keydown", (ev) => {
      if (ev.key === "Enter") saveBtn.click();
    });
  }

  saveBtn.addEventListener("click", () => {
    if (!secPerKm) return;
    history.unshift({ id: crypto.randomUUID(), at: Date.now(), unit, secPerKm });
    storeHistory(history);
    renderHistory();
    saveBtn.textContent = "Saved ✓";
    setTimeout(() => (saveBtn.textContent = "Save to history"), 1200);
  });

  clearBtn.addEventListener("click", () => {
    if (!confirm(`Delete all ${history.length} saved conversions?`)) return;
    history = [];
    storeHistory(history);
    renderHistory();
  });

  // Hold a step button to repeat. Keyboard activation arrives as a click.
  for (const b of stepButtons) {
    const n = Number(b.dataset.step);
    let timer: ReturnType<typeof setTimeout> | undefined;
    const stop = () => clearTimeout(timer);
    const repeat = (delay: number) => {
      timer = setTimeout(() => {
        step(n);
        repeat(90);
      }, delay);
    };
    b.addEventListener("pointerdown", (ev) => {
      ev.preventDefault();
      step(n);
      repeat(400);
    });
    for (const type of ["pointerup", "pointerleave", "pointercancel"]) b.addEventListener(type, stop);
    b.addEventListener("click", (ev) => {
      if (ev.detail === 0) step(n);
    });
    b.addEventListener("contextmenu", (ev) => ev.preventDefault());
  }

  // Swipe right to raise the number, left to lower it. The tick marks slide
  // with the finger so the strip feels like a wheel.
  let tickOffset = 0;
  let drag: { x: number; start: number; steps: number; offset: number } | null = null;
  scrub.addEventListener("pointerdown", (ev) => {
    scrub.setPointerCapture(ev.pointerId);
    drag = { x: ev.clientX, start: toUnit(secPerKm ?? DEFAULT_SEC_PER_KM), steps: 0, offset: tickOffset };
  });
  scrub.addEventListener("pointermove", (ev) => {
    if (!drag) return;
    const dx = ev.clientX - drag.x;
    tickOffset = drag.offset + dx;
    scrub.style.backgroundPositionX = `${tickOffset}px`;
    const steps = Math.trunc(dx / PX_PER_STEP);
    if (steps !== drag.steps) {
      drag.steps = steps;
      setValue(drag.start + steps * STEPS[unit].small);
    }
  });
  for (const type of ["pointerup", "pointercancel"]) scrub.addEventListener(type, () => (drag = null));
  scrub.addEventListener("keydown", (ev) => {
    if (ev.key === "ArrowRight" || ev.key === "ArrowUp") step(1);
    else if (ev.key === "ArrowLeft" || ev.key === "ArrowDown") step(-1);
    else return;
    ev.preventDefault();
  });

  // Reopen where you left off; first visit starts at 9:00 /mi.
  let last: { unit?: Unit; secPerKm?: number } = {};
  try {
    last = JSON.parse(localStorage.getItem(LAST_KEY) ?? "{}");
  } catch {
    // Use the default.
  }
  secPerKm = last.secPerKm && last.secPerKm > 0 ? last.secPerKm : DEFAULT_SEC_PER_KM;
  setUnit(last.unit && last.unit in STEPS ? last.unit : "mi");
  renderHistory();
</script>

<style>
  /* Tick marks, one per small step, that slide as you swipe. */
  .scrub {
    background-color: rgb(0 0 0 / 0.2);
    background-image: repeating-linear-gradient(
      to right,
      rgb(255 255 255 / 0.35) 0 2px,
      transparent 2px 25px
    );
    background-size: 25px 40%;
    background-repeat: repeat-x;
    background-position-y: center;
    touch-action: none;
  }
  .scrub:focus-visible {
    outline: 2px solid white;
    outline-offset: 2px;
  }
</style>

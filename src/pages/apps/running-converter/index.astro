---
import Base from "../../../layouts/Base.astro";

const units = [
  { id: "mi", label: "min/mi" },
  { id: "km", label: "min/km" },
  { id: "mph", label: "mph" },
  { id: "kmh", label: "km/h" },
];
// Everything below the input sits in one 4-column grid so it fits on a phone
// screen without scrolling. The tile for the input unit is hidden, leaving 8.
const results = [
  { id: "mi", label: "min/mi" },
  { id: "km", label: "min/km" },
  { id: "mph", label: "mph" },
  { id: "kmh", label: "km/h" },
  { id: "lap", label: "400 m lap" },
  { id: "5k", label: "5K", race: true },
  { id: "10k", label: "10K", race: true },
  { id: "half", label: "Half", race: true },
  { id: "full", label: "Marathon", race: true },
];
// Inputs read as one big centred number, not as form boxes.
const digits =
  "min-w-0 rounded-lg bg-transparent py-0.5 text-6xl font-bold tabular-nums text-white placeholder:text-white/40 focus:bg-white/15 focus:outline-none";
const raised = "touch-manipulation select-none focus:outline-none focus-visible:ring-2 focus-visible:ring-white";
---

<Base title="Running converter · pebabion" description="Convert a running pace or speed into every other unit, with race finish times.">
  <div class="mx-auto max-w-xl pb-12">
    <!-- A quiet breadcrumb instead of a big title; the card is the headline. -->
    <nav class="mb-2 text-sm text-gray-500 sm:mt-6 sm:mb-3 dark:text-gray-400" aria-label="Breadcrumb">
      <a href="/apps/" class="hover:text-green-600">Apps</a>
      <span class="mx-1" aria-hidden="true">/</span>
      <h1 class="inline font-medium text-gray-700 dark:text-gray-200">Running converter</h1>
    </nav>

    <section
      class="rounded-3xl bg-gradient-to-b from-green-600 to-green-800 p-3 text-white shadow-lg shadow-green-900/20 dark:from-green-700 dark:to-green-900"
      aria-label="Input"
    >
      <div class="grid grid-cols-4 gap-1 rounded-2xl bg-black/20 p-1" role="radiogroup" aria-label="Input unit">
        {
          units.map((u) => (
            <button
              type="button"
              role="radio"
              data-unit={u.id}
              class:list={[
                "min-h-10 rounded-xl text-base font-semibold text-white/75 transition-colors aria-checked:bg-white aria-checked:text-green-800 aria-checked:shadow",
                raised,
              ]}
            >
              {u.label}
            </button>
          ))
        }
      </div>

      <div class="flex items-baseline justify-center py-1">
        <div id="pace-input" class="flex items-baseline">
          <input id="min" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="2" placeholder="8" aria-label="Minutes" class:list={[digits, "w-[2.3ch] pr-1 text-right"]} />
          <span class="text-5xl font-bold text-white/80">:</span>
          <input id="sec" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="2" placeholder="30" aria-label="Seconds" class:list={[digits, "w-[2.3ch] pl-1 text-left"]} />
        </div>
        <div id="speed-input" hidden>
          <input id="speed" type="text" inputmode="decimal" placeholder="7.0" aria-label="Speed" class:list={[digits, "w-[4.6ch] text-center"]} />
        </div>
        <span id="unit-suffix" class="ml-2 text-xl font-semibold text-white/70">/mi</span>
      </div>

      <!-- One-tap adjustments; hold a button to keep stepping. -->
      <div class="grid grid-cols-4 gap-2" aria-label="Adjust">
        {
          [-2, -1, 1, 2].map((n) => (
            <button
              type="button"
              data-step={n}
              class:list={[
                "min-h-12 rounded-2xl text-lg font-bold tabular-nums transition-colors active:bg-white/40",
                n < 0 ? "bg-black/15" : "bg-white/20",
                raised,
              ]}
            />
          ))
        }
      </div>

      <!-- Relative drag: the value moves with your finger, not to where you touch. -->
      <div
        id="scrub"
        role="slider"
        tabindex="0"
        aria-label="Swipe to change"
        aria-describedby="scrub-hint"
        class:list={["scrub relative mt-2 h-12 cursor-ew-resize rounded-2xl bg-black/20", raised]}
      >
        <!-- Shows the running change while you swipe, e.g. "+15s". -->
        <span
          id="scrub-delta"
          class="pointer-events-none absolute bottom-full left-1/2 mb-1 -translate-x-1/2 rounded-full bg-white px-2.5 py-0.5 text-sm font-bold whitespace-nowrap text-green-800 tabular-nums opacity-0 shadow transition-opacity"
          aria-hidden="true"></span>
        <span class="pointer-events-none absolute inset-y-2 left-1/2 w-1 -translate-x-1/2 rounded-full bg-white shadow" aria-hidden="true"></span>
        <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-lg font-bold text-white/50" aria-hidden="true">‹</span>
        <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-lg font-bold text-white/50" aria-hidden="true">›</span>
      </div>
      <p id="scrub-hint" class="mt-1 text-center text-xs text-white/70">Swipe · each tick is 5s</p>
    </section>

    <section class="mt-3 grid grid-cols-4 gap-1.5 sm:gap-2" aria-label="Results" aria-live="polite">
      {
        results.map((r) => (
          <div data-result={r.id} class="min-w-0 rounded-xl bg-white px-1 py-2 text-center shadow-sm dark:bg-white/5 dark:shadow-none">
            <span class="block text-xs font-medium text-gray-500 dark:text-gray-400">{r.label}</span>
            <strong
              data-out={r.id}
              class:list={["text-base tabular-nums sm:text-lg", r.race && "text-green-700 dark:text-green-400"]}
            >
              –
            </strong>
          </div>
        ))
      }
    </section>

    <section class="mt-4" aria-labelledby="history-title">
      <div class="flex items-center justify-between">
        <h2 id="history-title" class="text-lg font-semibold">History</h2>
        <button
          id="save"
          type="button"
          disabled
          class="min-h-10 rounded-full bg-green-600 px-5 text-base font-semibold text-white transition-colors hover:bg-green-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-green-400 focus-visible:ring-offset-2 disabled:opacity-40 dark:focus-visible:ring-offset-main-dark-bg"
        >
          Save
        </button>
      </div>
      <p id="history-empty" class="mt-2 text-base text-gray-500 dark:text-gray-400">
        Tap Save to keep a conversion. History stays on this device only.
      </p>
      <ul id="history" class="mt-1 divide-y divide-gray-200 dark:divide-gray-700/70"></ul>
      <button id="clear" type="button" hidden class="mt-1 min-h-10 text-sm text-red-600 hover:underline dark:text-red-400">
        Clear all history
      </button>
    </section>
  </div>
</Base>

<script>
  import {
    DEFAULT_SEC_PER_KM,
    STEPS,
    type Unit,
    clock,
    describe,
    fromUnit,
    isPace,
    outputs,
    parsePace,
    parseSpeed,
    snap,
    toUnit,
  } from "../../../lib/running";

  type Entry = { id: string; at: number; unit: Unit; secPerKm: number };

  // Swipe distance for one small step. Higher is less sensitive.
  const PX_PER_STEP = 25;
  const LAST_KEY = "running-converter:last:v1";
  const STORAGE_KEY = "running-converter:history:v1";
  const MAX_HISTORY = 200;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const minEl = $<HTMLInputElement>("min");
  const secEl = $<HTMLInputElement>("sec");
  const speedEl = $<HTMLInputElement>("speed");
  const saveBtn = $<HTMLButtonElement>("save");
  const clearBtn = $<HTMLButtonElement>("clear");
  const historyEl = $<HTMLUListElement>("history");
  const scrub = $<HTMLDivElement>("scrub");
  const unitButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-unit]")];
  const stepButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-step]")];

  let unit: Unit = "mi";
  let secPerKm: number | null = null;

  const describeInput = (e: Pick<Entry, "unit" | "secPerKm">) => describe(e.secPerKm, e.unit);

  function readInput(): number | null {
    return isPace(unit) ? parsePace(minEl.value, secEl.value, unit) : parseSpeed(speedEl.value, unit);
  }

  function writeInput(spk: number) {
    const v = toUnit(spk, unit);
    if (isPace(unit)) {
      const total = Math.round(v);
      minEl.value = String(Math.floor(total / 60));
      secEl.value = String(total % 60).padStart(2, "0");
    } else {
      speedEl.value = String(Number(v.toFixed(2)));
    }
  }

  // Set a new value from the steppers or swipe: update the input too.
  function setValue(v: number) {
    secPerKm = fromUnit(snap(v, unit), unit);
    writeInput(secPerKm);
    render();
  }

  function step(n: number) {
    const { small, big } = STEPS[unit];
    const current = toUnit(secPerKm ?? DEFAULT_SEC_PER_KM, unit);
    setValue(current + Math.sign(n) * (Math.abs(n) === 2 ? big : small));
  }

  function render() {
    const o = secPerKm ? outputs(secPerKm) : null;
    document.querySelectorAll<HTMLElement>("[data-out]").forEach((el) => {
      el.textContent = o ? o[el.dataset.out!] : "–";
    });
    // Hide the result that just repeats the input.
    document.querySelectorAll<HTMLElement>("[data-result]").forEach((el) => {
      el.hidden = el.dataset.result === unit;
    });
    saveBtn.disabled = !secPerKm;
    if (secPerKm) {
      scrub.setAttribute("aria-valuetext", isPace(unit) ? `${clock(toUnit(secPerKm, unit))} per ${unit}` : `${toUnit(secPerKm, unit).toFixed(1)} ${unit}`);
      try {
        localStorage.setItem(LAST_KEY, JSON.stringify({ unit, secPerKm }));
      } catch {
        // Not critical.
      }
    }
  }

  function setUnit(next: Unit) {
    unit = next;
    for (const b of unitButtons) b.setAttribute("aria-checked", String(b.dataset.unit === unit));
    $("pace-input").hidden = !isPace(unit);
    $("speed-input").hidden = isPace(unit);
    $("unit-suffix").textContent = { mi: "/mi", km: "/km", mph: "mph", kmh: "km/h" }[unit];
    $("scrub-hint").textContent = `Swipe · each tick is ${formatDelta(1).slice(1)}`;

    const c = STEPS[unit];
    const sign = (n: number) => (n < 0 ? "−" : "+");
    for (const b of stepButtons) {
      const n = Number(b.dataset.step);
      const size = Math.abs(n) === 2 ? c.big : c.small;
      b.textContent = `${sign(n)}${isPace(unit) ? `${size}s` : size}`;
    }
    if (secPerKm) writeInput(secPerKm);
    render();
  }

  // History, kept in this browser only

  function loadHistory(): Entry[] {
    try {
      const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "[]");
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }

  function storeHistory(entries: Entry[]) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(entries.slice(0, MAX_HISTORY)));
    } catch {
      // Storage blocked or full; history just won't persist.
    }
  }

  let history = loadHistory();

  // "2:56 PM" for today, "Oct 4" for earlier.
  function whenLabel(at: number) {
    const d = new Date(at);
    return d.toDateString() === new Date().toDateString()
      ? d.toLocaleTimeString(undefined, { hour: "numeric", minute: "2-digit" })
      : d.toLocaleDateString(undefined, { month: "short", day: "numeric" });
  }

  function renderHistory() {
    historyEl.replaceChildren(
      ...history.map((e) => {
        const o = outputs(e.secPerKm);
        const li = document.createElement("li");
        li.className = "flex items-center gap-1";

        const load = document.createElement("button");
        load.type = "button";
        load.className = "flex min-h-12 min-w-0 flex-1 items-baseline gap-2 py-1.5 text-left";
        load.innerHTML = `
          <span class="shrink-0 font-semibold tabular-nums"></span>
          <span class="truncate text-sm text-gray-600 tabular-nums dark:text-gray-400"></span>
          <span class="ml-auto shrink-0 text-xs text-gray-500"></span>`;
        const [title, detail, when] = load.children as unknown as HTMLElement[];
        title.textContent = describeInput(e);
        // The two numbers you'd most likely want next to the one you typed.
        const related: Record<Unit, string[]> = {
          mi: [`${o.km} /km`, `${o.mph} mph`],
          km: [`${o.mi} /mi`, `${o.kmh} km/h`],
          mph: [`${o.mi} /mi`, `${o.km} /km`],
          kmh: [`${o.km} /km`, `${o.mi} /mi`],
        };
        detail.textContent = related[e.unit].join(" · ");
        when.textContent = whenLabel(e.at);
        load.setAttribute("aria-label", `Load ${describeInput(e)}`);
        load.addEventListener("click", () => {
          secPerKm = e.secPerKm;
          setUnit(e.unit);
          window.scrollTo({ top: 0, behavior: "smooth" });
        });

        const del = document.createElement("button");
        del.type = "button";
        del.className =
          "flex size-10 shrink-0 items-center justify-center rounded-full text-xl text-gray-400 hover:bg-gray-100 hover:text-red-600 dark:hover:bg-gray-700";
        del.textContent = "×";
        del.setAttribute("aria-label", `Delete ${describeInput(e)}`);
        del.addEventListener("click", () => {
          history = history.filter((h) => h.id !== e.id);
          storeHistory(history);
          renderHistory();
        });

        li.append(load, del);
        return li;
      }),
    );
    $("history-empty").hidden = history.length > 0;
    clearBtn.hidden = history.length === 0;
  }

  // Wiring

  for (const b of unitButtons) b.addEventListener("click", () => setUnit(b.dataset.unit as Unit));
  for (const el of [minEl, secEl, speedEl]) {
    el.addEventListener("input", () => {
      secPerKm = readInput();
      render();
    });
  }
  // Select the whole value on tap so typing replaces it. iOS ignores select()
  // during focus, so defer it, and keep a mouse click from clearing it.
  for (const el of [minEl, secEl, speedEl]) {
    let justFocused = false;
    el.addEventListener("focus", () => {
      justFocused = true;
      el.select();
      setTimeout(() => el.setSelectionRange(0, el.value.length), 0);
    });
    el.addEventListener("mouseup", (ev) => {
      if (justFocused) ev.preventDefault();
      justFocused = false;
    });
  }
  // Jump to seconds once the minutes look complete.
  minEl.addEventListener("input", () => {
    if (minEl.value.length === 2) secEl.focus();
  });
  for (const el of [minEl, secEl, speedEl]) {
    el.addEventListener("keydown", (ev) => {
      if (ev.key === "Enter") saveBtn.click();
    });
  }

  saveBtn.addEventListener("click", () => {
    if (!secPerKm) return;
    // Saving the same value twice in a row just bumps its time.
    const top = history[0];
    if (top && top.unit === unit && describeInput(top) === describeInput({ unit, secPerKm })) {
      top.at = Date.now();
    } else {
      history.unshift({ id: crypto.randomUUID(), at: Date.now(), unit, secPerKm });
    }
    storeHistory(history);
    renderHistory();
    saveBtn.textContent = "Saved ✓";
    setTimeout(() => (saveBtn.textContent = "Save"), 1200);
  });

  clearBtn.addEventListener("click", () => {
    if (!confirm(`Delete all ${history.length} saved conversions?`)) return;
    history = [];
    storeHistory(history);
    renderHistory();
  });

  // Hold a step button to repeat. Keyboard activation arrives as a click.
  for (const b of stepButtons) {
    const n = Number(b.dataset.step);
    let timer: ReturnType<typeof setTimeout> | undefined;
    const stop = () => clearTimeout(timer);
    const repeat = (delay: number) => {
      timer = setTimeout(() => {
        step(n);
        repeat(90);
      }, delay);
    };
    b.addEventListener("pointerdown", (ev) => {
      ev.preventDefault();
      step(n);
      repeat(400);
    });
    for (const type of ["pointerup", "pointerleave", "pointercancel"]) b.addEventListener(type, stop);
    b.addEventListener("click", (ev) => {
      if (ev.detail === 0) step(n);
    });
    b.addEventListener("contextmenu", (ev) => ev.preventDefault());
  }

  // Swipe right to raise the number, left to lower it. The tick marks slide
  // with the finger so the strip feels like a wheel.
  let tickOffset = 0;
  const deltaEl = $("scrub-delta");
  let hideDelta: ReturnType<typeof setTimeout> | undefined;

  // A change of n small steps, signed, in the unit's terms: "+15s", "−1:05", "+0.3".
  function formatDelta(n: number) {
    const sign = n < 0 ? "−" : "+";
    const size = Math.abs(n) * STEPS[unit].small;
    if (!isPace(unit)) return `${sign}${size.toFixed(1)} ${unit === "mph" ? "mph" : "km/h"}`;
    return size < 60 ? `${sign}${size}s` : `${sign}${clock(size)}`;
  }
  function showDelta(n: number) {
    clearTimeout(hideDelta);
    deltaEl.textContent = n === 0 ? "±0" : formatDelta(n);
    deltaEl.classList.remove("opacity-0");
  }

  let drag: { x: number; start: number; steps: number; offset: number } | null = null;
  scrub.addEventListener("pointerdown", (ev) => {
    scrub.setPointerCapture(ev.pointerId);
    drag = { x: ev.clientX, start: toUnit(secPerKm ?? DEFAULT_SEC_PER_KM, unit), steps: 0, offset: tickOffset };
    showDelta(0);
  });
  scrub.addEventListener("pointermove", (ev) => {
    if (!drag) return;
    const dx = ev.clientX - drag.x;
    tickOffset = drag.offset + dx;
    scrub.style.setProperty("--tick-x", `${tickOffset}px`);
    const steps = Math.trunc(dx / PX_PER_STEP);
    if (steps !== drag.steps) {
      drag.steps = steps;
      setValue(drag.start + steps * STEPS[unit].small);
      showDelta(steps);
    }
  });
  for (const type of ["pointerup", "pointercancel"]) {
    scrub.addEventListener(type, () => {
      drag = null;
      hideDelta = setTimeout(() => deltaEl.classList.add("opacity-0"), 700);
    });
  }
  scrub.addEventListener("keydown", (ev) => {
    if (ev.key === "ArrowRight" || ev.key === "ArrowUp") step(1);
    else if (ev.key === "ArrowLeft" || ev.key === "ArrowDown") step(-1);
    else return;
    ev.preventDefault();
  });

  // Reopen where you left off; first visit starts at 9:00 /mi.
  let last: { unit?: Unit; secPerKm?: number } = {};
  try {
    last = JSON.parse(localStorage.getItem(LAST_KEY) ?? "{}");
  } catch {
    // Use the default.
  }
  secPerKm = last.secPerKm && last.secPerKm > 0 ? last.secPerKm : DEFAULT_SEC_PER_KM;
  setUnit(last.unit && last.unit in STEPS ? last.unit : "mi");
  renderHistory();
</script>

<style>
  /* Tick marks, one per small step, that slide as you swipe. */
  /* Tick marks, one per small step, that slide as you swipe and fade out at
     the edges. JS moves them through --tick-x. */
  .scrub {
    touch-action: none;
  }
  .scrub::before {
    content: "";
    position: absolute;
    inset: 0.75rem 0;
    background-image: repeating-linear-gradient(
      to right,
      rgb(255 255 255 / 0.45) 0 2px,
      transparent 2px 25px
    );
    background-position-x: var(--tick-x, 0px);
    mask-image: linear-gradient(to right, transparent, black 25%, black 75%, transparent);
  }
</style>
